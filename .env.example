# Veda Learning — environment variables
# Copy this file to .env.local and fill in the values you have.
#
# The app runs with ZERO of these set: it falls back to a local, in-browser
# (IndexedDB) data provider and "guest mode" for everything, which is what
# powers the demo/guest flow described in the product spec. Set the
# NEXT_PUBLIC_SUPABASE_* pair below once you've created a Supabase project to
# switch the whole app over to real accounts, a shared database, and durable
# history — no code changes required.

# --- Supabase (public — safe to expose to the browser) ---------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — NEVER exposed to the browser) -----------------
# Used only by scripts/migrate + scripts/seed and server-only route handlers,
# never imported from anything under src/app or src/components.
SUPABASE_SERVICE_ROLE_KEY=

# --- App configuration -------------------------------------------------------
# Optional: overrides the default note→scale mapping / pitch tolerance JSON
# baked into src/lib/config/appConfig.ts. Leave unset to use the defaults
# (also editable at runtime from the admin "Configuration" page once a
# Supabase project is connected).
NEXT_PUBLIC_APP_CONFIG_URL=

# --- Feature flags -----------------------------------------------------------
# When "true", uploading a student's raw recording to Storage is offered as an
# opt-in. Regardless of this flag, nothing is uploaded without explicit
# per-recording consent (see docs/LIMITATIONS.md, "Privacy & child safety").
NEXT_PUBLIC_ALLOW_RECORDING_UPLOAD=false
